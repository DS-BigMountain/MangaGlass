# Only application sources, resources, build files and the user guide belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/app/
!/scripts/

/scripts/*
!/scripts/build.ps1

/gradle/*
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

/app/*
!/app/build.gradle.kts
!/app/src/
/app/src/*
!/app/src/main/

# Generated files, local settings and credentials.
**/build/
.gradle/
.idea/
local.properties
*.iml
*.jks
*.keystore
*.apk
*.aab
*.apks
*.idsig
.env
.env.*
.DS_Store
Thumbs.db
